# ==============================================================================
# Vía Justa — Configuración de Entorno (Plantilla de ejemplo segura)
# ==============================================================================
# IMPORTANTE: Copie este archivo como '.env' para desarrollo local.
# NUNCA ingrese claves reales ni suba credenciales privadas al repositorio.

# Backend Supabase (VJ-07 / VJ-08)
# La app NO lee este archivo en tiempo de ejecución: las credenciales se
# inyectan al compilar y solo se usa la clave pública (anon/publishable).
#   flutter run -d <device-id> --no-pub --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
# Sin esas variables la app arranca en modo DEMO.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-placeholder

# Google Maps Platform (Planificado para VJ-12)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-placeholder

# Entorno de ejecución
APP_ENV=development
ENABLE_DEMO_DATA=true
