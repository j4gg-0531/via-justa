<?xml version="1.0" encoding="utf-8"?>
<!--
  H-02 / H-01 (OWASP M8 / M9 — Fugas de datos en backups):
  Excluye preferencias compartidas, bases de datos y archivos locales de Android Auto Backup (API <= 30).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
